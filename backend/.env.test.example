# Copy to .env.test. Never point application tests at the development database.
PGHOST=localhost
PGPORT=5432
PGDATABASE=garageguide_app_test
PGUSER=
PGPASSWORD=

# Explicit loopback tests only; never reuse these settings in production.
AUTH_ENVIRONMENT=testing
AUTH_COOKIE_SECURE=false
AUTH_API_ORIGIN=http://127.0.0.1:8000
AUTH_FRONTEND_ORIGIN=
