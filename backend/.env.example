# Copy to .env. Supply your local PostgreSQL role and password privately.
PGHOST=localhost
PGPORT=5432
PGDATABASE=garageguide_app
PGUSER=
PGPASSWORD=

# Explicit local-only cookie mode. Production requires Secure=true and matching
# canonical HTTPS API/frontend origins; do not copy these local values there.
AUTH_ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
AUTH_API_ORIGIN=http://127.0.0.1:8000
AUTH_FRONTEND_ORIGIN=
